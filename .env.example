# Copy to .env and fill in real values. .env is git-ignored.

# Database (SQLite for local dev, Postgres in docker-compose)
DATABASE_URL=sqlite:///./studyroom.db

# REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In DEBUG mode a random ephemeral key is used if this is unset (tokens reset on restart).
SECRET_KEY=

# Set to "true" for local development only
DEBUG=true

# Redis (optional; live metrics fall back to no-op without it)
REDIS_URL=redis://localhost:6379/0

# --- Optional AI features ---
# Local Ollama for the multi-agent advisor
OLLAMA_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=deepseek-r1:8b
OLLAMA_FALLBACK_MODEL=tinyllama

# External OpenAI-compatible endpoint for /llm/quiz/generate
# (endpoint returns 503 until both are set)
LLM_BASE_URL=
LLM_API_KEY=
